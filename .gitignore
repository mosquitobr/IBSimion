# =============================================================================
# IBSimion 2.0.1.e4l - Dedicated Gitignore for F/v2.0.1.e4l-release
# =============================================================================

# Ignore Python caches, logs and local virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
logs/

# Ignore compiled C++ binaries and object files
ibsimu_wrapper
*.o
*.a
*.so

# Ignore local execution artifacts and data dumps (Strict Block)
*.dat
backend/*.dat
backend/pout_*.txt
backend/field.txt
backend/potential.txt
backend/trajectories.txt
backend/geometry.obj
backend/config_scenario.json
backend/current_density.dat

# Block documentation walkthroughs from release
walkthrough.md
walkthrough*.md
bent/teste*/walkthrough*.md
*.tmp
*.log

# Whitelist source files, scripts and assets to bypass root ignores
!install_and_launch.sh
!uninstall.sh
!MANUAL.md
!README.md
!MANIFEST.md
!LICENSE
!frontend/*.py
!backend/*.cpp
!backend/Makefile
!backend/config_scenario_test4.json
!backend/config_pic_test.json
!bent/*.py
!bent/teste*/*.cpp
!bent/teste*/Makefile
!bent/teste*/*.dxf
!data/*.dxf